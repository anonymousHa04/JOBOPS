# JobOps settings. Copy to .env (git-ignored) and change what you need:
#   cp .env.example .env
# Every value here is also the default in code, so a missing .env changes nothing.
# A variable already set in the shell wins over this file. Keep the format plain
# KEY=value (no spaces, no quotes): the shell scripts read this file too.
# No secrets belong here: models run locally and the job APIs need no keys.

# --- Data -------------------------------------------------------------------
# SQLite database (jobs, requirements, judge cache, record index).
DB_PATH=data/jobops.db
# Resume bank, records, reviews, preferences (git-ignored; never sent to a cloud model).
JOBOPS_PROFILE_DIR=profile
# The user's prompt files.
JOBOPS_PROMPTS_DIR=requierements

# --- API --------------------------------------------------------------------
PORT=3000
# Where jd-search (Go) sends jobs.
JOBOPS_API=http://localhost:3000

# --- Local models (llama.cpp, .claude/bin/llm.sh) ---------------------------
# GGUF files.
LLM_MODELS_DIR=~/models/jobops
# Servers: general7 = qwen2.5 7B, general14 = qwen2.5 14B. Only one heavy model runs at a time.
LLM_GENERAL7_URL=http://127.0.0.1:8084/v1
LLM_GENERAL14_URL=http://127.0.0.1:8085/v1
# Which model does what. The defaults live in api/config/models.yaml (with timeouts and
# answer limits; override in profile/models.yaml); these settings, when set, win.
JOBOPS_PARSE_MODEL=qwen2.5:14b
JOBOPS_JD_MODEL=qwen2.5:7b
JOBOPS_JUDGE_MODEL=qwen2.5:7b
# Judge calls at once, and the general7 server's slots to serve them (keep them equal).
JOBOPS_JUDGE_PARALLEL=3
LLM_GENERAL7_SLOTS=3
JOBOPS_REWORD_MODEL=qwen2.5:14b
# One line per model call (task, model, outcome, time, tokens; never text): models stats.
# JOBOPS_MODEL_LOG=data/model-calls.jsonl
# Careers-site crawler that jd-search runs for companies with ats: careers (needs
# Google Chrome installed). Default: node ../api/src/careers/crawl.ts, from jd-search/.
# JOBOPS_CRAWLER=node ../api/src/careers/crawl.ts

# --- Agent knowledge layer (not the product) --------------------------------
# Qdrant (Docker, infra/qdrant/docker-compose.yml) and the embedding server.
QDRANT_URL=http://localhost:6333
QDRANT_DATA_DIR=../../data/qdrant
EMBED_URL=http://127.0.0.1:8082
EMBED_MODEL=mxbai-embed-large
KNOWLEDGE_COLLECTION=jobops_knowledge
