#!/bin/sh
# JobOps in local Kubernetes (Docker Desktop, kubeadm). RUNBOOK-M8.md explains each step.
#
#   bin/jobops up            build the image, load .env as a Secret, apply infra/k8s, wait
#   bin/jobops down          stop every pod (scale to 0); the database volume is kept
#   bin/jobops ui            (re)open localhost:8080 (UI) and :3000 (extension); up does it too
#   bin/jobops status        pods, restarts, and whether the UI answers
#   bin/jobops logs <name>   follow one service's log: api, queue, worker-laptop, worker-mac, gateway
#   bin/jobops cli <args>    run the JobOps CLI inside the cluster, e.g. bin/jobops cli batch status
#   bin/jobops db-import [--force]   copy data/jobops.db into the cluster volume (once)
#   bin/jobops db-backup     copy the cluster database to data/backups/jobops-<time>.db
#
# The models are not in the cluster: start general14 and embed with .claude/bin/llm.sh, and
# general7 on the laptop (C:\llama\start-server.cmd).
set -eu
R=$(cd "$(dirname "$0")/.." && pwd)
cd "$R"
NS=jobops
IMAGE=jobops:dev
DEPLOYS="queue api worker-laptop worker-mac gateway"
k() { kubectl --context docker-desktop -n "$NS" "$@"; }
die() { echo "jobops: $*" >&2; exit 1; }
PF_PID=data/port-forward.pid

# Two ports on the Mac, bound to 127.0.0.1 only (see infra/k8s/gateway.yaml for why):
#   localhost:8080 -> gateway (the web UI)     localhost:3000 -> api (the Chrome extension)
# kubectl port-forward exits when its pod goes away, so a loop restarts it.
forward_stop() {
  [ -f "$PF_PID" ] && kill $(cat "$PF_PID") 2>/dev/null || true
  rm -f "$PF_PID"
  pkill -f "kubectl --context docker-desktop -n $NS port-forward" 2>/dev/null || true # the loops' children
}
forward_one() { # <service> <port>
  nohup sh -c "while true; do kubectl --context docker-desktop -n $NS port-forward --address 127.0.0.1 svc/$1 $2:$2; sleep 2; done" \
    >"data/port-forward-$1.log" 2>&1 &
  echo $! >>"$PF_PID"
}
forward_start() {
  forward_stop
  mkdir -p data
  forward_one gateway 8080
  forward_one api 3000
  i=0; until curl -s -m 2 -o /dev/null http://127.0.0.1:8080/health; do
    i=$((i + 1)); [ "$i" -gt 20 ] && die "localhost:8080 did not open: see data/port-forward-gateway.log"; sleep 1
  done
}

need_cluster() {
  kubectl --context docker-desktop get nodes >/dev/null 2>&1 \
    || die "Kubernetes is not running. Docker Desktop > Settings > Kubernetes (kubeadm), then try again."
}

# The manifests with this repo's path in place of __REPO__ (hostPath needs an absolute path).
render() { kubectl kustomize infra/k8s | sed "s#__REPO__#$R#g"; }

secret() { # .env becomes the Secret jobops-env (never written to a file)
  [ -f .env ] || { echo "no .env: pods use the defaults and infra/k8s/config.yaml"; return 0; }
  kubectl --context docker-desktop -n "$NS" create secret generic jobops-env --from-env-file=.env \
    --dry-run=client -o yaml | kubectl --context docker-desktop apply -f - >/dev/null
  echo "[ok] Secret jobops-env from .env"
}

# A short-lived pod that mounts the data volume, for copying the database in and out.
helper_up() {
  k delete pod jobops-db --ignore-not-found --wait=true >/dev/null
  cat <<YAML | k apply -f - >/dev/null
apiVersion: v1
kind: Pod
metadata: { name: jobops-db }
spec:
  restartPolicy: Never
  containers:
    - name: db
      image: $IMAGE
      imagePullPolicy: Never
      command: [sleep, "3600"]
      volumeMounts: [{ name: data, mountPath: /app/data }]
  volumes:
    - name: data
      persistentVolumeClaim: { claimName: jobops-data }
YAML
  k wait pod/jobops-db --for=condition=Ready --timeout=90s >/dev/null
}
helper_down() { k delete pod jobops-db --ignore-not-found --wait=false >/dev/null; }

case "${1:-}" in
  up)
    need_cluster
    echo "building $IMAGE (first build takes a few minutes)..."
    docker build -q -t "$IMAGE" . >/dev/null
    echo "[ok] image $IMAGE"
    kubectl --context docker-desktop apply -f infra/k8s/namespace.yaml >/dev/null
    secret
    render | kubectl --context docker-desktop apply -f - >/dev/null
    echo "[ok] manifests applied"
    for d in $DEPLOYS; do k rollout restart "deploy/$d" >/dev/null; done # pick up the new image
    for d in $DEPLOYS; do
      k rollout status "deploy/$d" --timeout=180s >/dev/null || die "$d did not start: bin/jobops logs $d"
      echo "[ok] $d"
    done
    forward_start
    echo "UI: http://localhost:8080"
    ;;
  ui)
    need_cluster
    forward_start
    echo "UI: http://localhost:8080"
    ;;
  down)
    need_cluster
    forward_stop
    for d in $DEPLOYS; do k scale "deploy/$d" --replicas=0 >/dev/null 2>&1 || true; done
    echo "stopped (database kept; bin/jobops up starts everything again)"
    ;;
  status)
    need_cluster
    k get pods -o wide
    printf "UI http://localhost:8080: "
    curl -s -m 3 -o /dev/null -w '%{http_code}\n' http://localhost:8080/health || echo "not answering"
    ;;
  logs)
    [ $# -ge 2 ] || die "usage: bin/jobops logs <$(echo $DEPLOYS | tr ' ' '|')>"
    k logs -f --tail=100 "deploy/$2"
    ;;
  cli)
    shift
    if [ -t 0 ]; then t=-it; else t=-i; fi
    k exec "$t" deploy/api -- node api/src/cli.ts "$@"
    ;;
  db-import)
    need_cluster
    [ -f data/jobops.db ] || die "no data/jobops.db to import"
    kubectl --context docker-desktop apply -f infra/k8s/namespace.yaml >/dev/null
    k apply -f infra/k8s/storage.yaml >/dev/null   # only the volume: pods start with bin/jobops up
    for d in $DEPLOYS; do k scale "deploy/$d" --replicas=0 >/dev/null 2>&1 || true; done
    k wait pod -l 'app in (queue,api,worker-laptop,worker-mac)' --for=delete --timeout=320s >/dev/null 2>&1 || true
    helper_up
    jobs=$(k exec jobops-db -- sh -c 'test -f /app/data/jobops.db && sqlite3 /app/data/jobops.db "SELECT count(*) FROM jobs" 2>/dev/null || echo 0')
    if [ "${jobs:-0}" != "0" ] && [ "${2:-}" != "--force" ]; then
      helper_down
      die "the cluster database already has $jobs jobs; run bin/jobops db-import --force to replace it (it is kept as jobops.db.before-import)"
    fi
    tmp=$(mktemp -d)
    sqlite3 data/jobops.db ".backup '$tmp/jobops.db'"   # a consistent copy, even while the local API runs
    k exec jobops-db -- sh -c 'cd /app/data && { [ -f jobops.db ] && mv jobops.db jobops.db.before-import || true; } && rm -f jobops.db-wal jobops.db-shm'
    k cp "$tmp/jobops.db" jobops-db:/app/data/jobops.db
    rm -rf "$tmp"
    n=$(k exec jobops-db -- sqlite3 /app/data/jobops.db "SELECT count(*) FROM jobs")
    helper_down
    echo "[ok] imported data/jobops.db ($n jobs). Stop the local API, queue and workers now: from here"
    echo "     the cluster has its own copy. Then: bin/jobops up"
    ;;
  db-backup)
    need_cluster
    mkdir -p data/backups
    out="data/backups/jobops-$(date +%Y%m%d-%H%M%S).db"
    helper_up
    k exec jobops-db -- sqlite3 /app/data/jobops.db ".backup /app/data/backup.db"
    k cp jobops-db:/app/data/backup.db "$out"
    k exec jobops-db -- rm -f /app/data/backup.db
    helper_down
    echo "[ok] $out"
    ;;
  *)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    [ -z "${1:-}" ] || exit 1
    ;;
esac
