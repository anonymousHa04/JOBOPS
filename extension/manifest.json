{
  "manifest_version": 3,
  "name": "JobOps",
  "version": "0.1.0",
  "description": "Ask Claude or ChatGPT for a job report and save it to your local JobOps (job description and gaps only; no resume)",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobOps"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": ["chat.js"],
      "run_at": "document_idle"
    }
  ]
}
