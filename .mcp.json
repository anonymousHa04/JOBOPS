{
  "mcpServers": {
    "mini-swe-agent": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        ".claude/mcp/mini_server.py"
      ]
    },
    "github": {
      "command": ".claude/mcp/github.sh",
      "args": []
    },
    "jobops-tools": {
      "command": "node",
      "args": [
        "api/src/mcp/server.ts"
      ]
    },
    "jd-search": {
      "command": "sh",
      "args": [
        "-c",
        "cd jd-search && exec go run ./cmd/jd-search mcp"
      ]
    }
  }
}
